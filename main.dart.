// ==================== ১. ইন-মেমোরি ব্যাকএন্ড ও রোল ডাটা ====================
class AppState {
  // বর্তমানে লগইন থাকা ইউজারের তথ্য
  static Map<String, String> currentUser = {
    'name': 'হাফেজ মো: জামিল',
    'phone': '01700000000',
    'role': 'Director', // 'Director' বা 'Student'
  };

  static List<Map<String, dynamic>> posts = [
    {
      'author': 'হাফেজ মো: জামিল',
      'role': 'Director',
      'time': '১০ মিনিট আগে',
      'content': 'আসসালামু আলাইকুম। আল-জামিল একাডেমির নতুন সেশনের ক্যালিগ্রাফি কোর্স শুরু হয়েছে!',
      'likes': 18,
      'isLiked': false,
      'comments': <String>['মাশাআল্লাহ স্যার, অনেক শুভকামনা!'],
    },
    {
      'author': 'মো: আব্দুল্লাহ',
      'role': 'Student',
      'time': '১ ঘণ্টা আগে',
      'content': 'আলহামদুলিল্লাহ, ৩য় ক্লাসের পর আমার হাতের লেখার উন্নতি হয়েছে। সবাই দোয়া করবেন।',
      'likes': 9,
      'isLiked': false,
      'comments': <String>['অনেক সুন্দর হয়েছে ভাই।'],
    },
  ];

  static void addPost(String content) {
    posts.insert(0, {
      'author': currentUser['name']!,
      'role': currentUser['role']!,
      'time': 'এইমাত্র',
      'content': content,
      'likes': 0,
      'isLiked': false,
      'comments': <String>[],
    });
  }

  static void toggleLike(int index) {
    if (posts[index]['isLiked']) {
      posts[index]['likes']--;
      posts[index]['isLiked'] = false;
    } else {
      posts[index]['likes']++;
      posts[index]['isLiked'] = true;
    }
  }

  static void addComment(int index, String comment) {
    (posts[index]['comments'] as List<String>).add(comment);
  }
}

// ==================== ২. মোবাইল নম্বর দিয়ে লগইন স্ক্রিন ====================
class LoginScreen extends StatefulWidget {
  const LoginScreen({super.key});

  @override
  State<LoginScreen> createState() => _LoginScreenState();
}

class _LoginScreenState extends State<LoginScreen> {
  final TextEditingController _phoneController = TextEditingController();
  final TextEditingController _nameController = TextEditingController();
  bool _isDirector = false;

  void _login() {
    String phone = _phoneController.text.trim();
    String name = _nameController.text.trim();

    if (phone.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('অনুগ্রহ করে সঠিক মোবাইল নম্বর দিন!')),
      );
      return;
    }

    // তথ্য সেভ করা
    AppState.currentUser['phone'] = phone;
    AppState.currentUser['name'] = name.isEmpty ? 'শিক্ষার্থী ইউজার' : name;
    AppState.currentUser['role'] = _isDirector ? 'Director' : 'Student';

    // মূল ড্যাশবোর্ডে নিয়ে যাওয়া
    Navigator.pushReplacement(
      context,
      MaterialPageRoute(builder: (context) => const MainDashboard()),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.white,
      body: SafeArea(
        child: SingleChildScrollView(
          padding: const EdgeInsets.symmetric(horizontal: 24.0, vertical: 40.0),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.center,
            children: [
              const SizedBox(height: 20),
              const Icon(Icons.school_rounded, size: 80, color: Color(0xFF00897B)),
              const SizedBox(height: 12),
              const Text(
                'Al-Jameel Academy',
                style: TextStyle(fontSize: 26, fontWeight: FontWeight.bold, color: Colors.black87),
              ),
              const Text(
                'এডুকেশনাল সোশ্যাল নেটওয়ার্ক',
                style: TextStyle(fontSize: 13, color: Colors.grey),
              ),
              const SizedBox(height: 40),

              // নাম ইনপুট
              TextField(
                controller: _nameController,
                decoration: InputDecoration(
                  labelText: 'আপনার নাম',
                  prefixIcon: const Icon(Icons.person_outline),
                  border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),
                ),
              ),
              const SizedBox(height: 16),

              // মোবাইল নম্বর ইনপুট
              TextField(
                controller: _phoneController,
                keyboardType: TextInputType.phone,
                decoration: InputDecoration(
                  labelText: 'মোবাইল নম্বর',
                  hintText: '017XXXXXXXX',
                  prefixIcon: const Icon(Icons.phone_android_rounded),
                  border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),
                ),
              ),
              const SizedBox(height: 16),

              // ডিরেক্টর/পরিচালক হিসেবে প্রবেশের সুইচ
              CheckboxListTile(
                activeColor: const Color(0xFF00897B),
                title: const Text('আমি একাডেমি পরিচালক (Admin)', style: TextStyle(fontSize: 14, fontWeight: FontWeight.w600)),
                subtitle: const Text('পরিচালক ব্যাজ ও অ্যাডমিন অপশন অন হবে', style: TextStyle(fontSize: 11)),
                value: _isDirector,
                onChanged: (val) {
                  setState(() {
                    _isDirector = val ?? false;
                    if (_isDirector && _nameController.text.isEmpty) {
                      _nameController.text = 'হাফেজ মো: জামিল';
                    }
                  });
                },
              ),
              const SizedBox(height: 20),

              // লগইন বাটন
              SizedBox(
                width: double.infinity,
                height: 50,
                child: ElevatedButton(
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF00897B),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(25)),
                  ),
                  onPressed: _login,
                  child: const Text('নম্বর দিয়ে প্রবেশ করুন', style: TextStyle(fontSize: 16, color: Colors.white, fontWeight: FontWeight.bold)),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

