// ==================== ৪. ফিড (সবাই পোস্ট করতে পারবে) ====================
class FeedTab extends StatefulWidget {
  const FeedTab({super.key});

  @override
  State<FeedTab> createState() => _FeedTabState();
}

class _FeedTabState extends State<FeedTab> {
  final TextEditingController _postController = TextEditingController();

  void _showCreatePostModal(BuildContext context) {
    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(borderRadius: BorderRadius.vertical(top: Radius.circular(20))),
      builder: (context) => Padding(
        padding: EdgeInsets.only(bottom: MediaQuery.of(context).viewInsets.bottom, left: 16, right: 16, top: 20),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text('নতুন পোস্ট তৈরি করুন', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
            const SizedBox(height: 12),
            TextField(
              controller: _postController,
              maxLines: 4,
              decoration: const InputDecoration(
                hintText: 'আপনার মনে কী আছে? নতুন হাতের লেখা শেয়ার করুন...',
                border: OutlineInputBorder(),
              ),
            ),
            const SizedBox(height: 12),
            Row(
              children: [
                IconButton(icon: const Icon(Icons.photo_library, color: Colors.green), onPressed: () {}),
                IconButton(icon: const Icon(Icons.videocam, color: Colors.red), onPressed: () {}),
                const Spacer(),
                ElevatedButton(
                  style: ElevatedButton.styleFrom(backgroundColor: const Color(0xFF00897B)),
                  onPressed: () {
                    if (_postController.text.trim().isNotEmpty) {
                      setState(() {
                        AppState.addPost(_postController.text.trim());
                      });
                      _postController.clear();
                      Navigator.pop(context);
                    }
                  },
                  child: const Text('পোস্ট করুন', style: TextStyle(color: Colors.white)),
                ),
              ],
            ),
            const SizedBox(height: 16),
          ],
        ),
      ),
    );
  }

  void _showCommentDialog(int index) {
    final TextEditingController commentController = TextEditingController();
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('কমেন্ট করুন', style: TextStyle(fontSize: 16)),
        content: TextField(
          controller: commentController,
          decoration: const InputDecoration(hintText: 'আপনার মন্তব্য লিখুন...', border: OutlineInputBorder()),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(context), child: const Text('বাতিল')),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: const Color(0xFF00897B)),
            onPressed: () {
              if (commentController.text.trim().isNotEmpty) {
                setState(() {
                  AppState.addComment(index, commentController.text.trim());
                });
                Navigator.pop(context);
              }
            },
            child: const Text('পাঠান', style: TextStyle(color: Colors.white)),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('আল-জামিল সোশ্যাল ফিড', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
        backgroundColor: const Color(0xFF00897B),
      ),
      body: SingleChildScrollView(
        child: Column(
          children: [
            Card(
              margin: const EdgeInsets.all(12),
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
              child: ListTile(
                leading: const CircleAvatar(backgroundColor: Color(0xFF00897B), child: Icon(Icons.person, color: Colors.white)),
                title: const Text('নতুন কিছু শেয়ার করুন...', style: TextStyle(color: Colors.grey, fontSize: 14)),
                trailing: const Icon(Icons.add_photo_alternate_rounded, color: Color(0xFF00897B)),
                onTap: () => _showCreatePostModal(context),
              ),
            ),
            ListView.builder(
              shrinkWrap: true,
              physics: const NeverScrollableScrollPhysics(),
              itemCount: AppState.posts.length,
              itemBuilder: (context, index) {
                final post = AppState.posts[index];
                return _buildPostCard(index, post);
              },
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildPostCard(int index, Map<String, dynamic> post) {
    List comments = post['comments'] ?? [];
    bool isDirector = post['role'] == 'Director';

    return Card(
      margin: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: Padding(
        padding: const EdgeInsets.all(12),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                CircleAvatar(
                  backgroundColor: const Color(0xFF00897B).withOpacity(0.2),
                  child: Text(post['author'][0], style: const TextStyle(color: Color(0xFF00897B), fontWeight: FontWeight.bold)),
                ),
                const SizedBox(width: 10),
                Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      children: [
                        Text(post['author'], style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 14)),
                        const SizedBox(width: 6),
                        if (isDirector)
                          Container(
                            padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                            decoration: BoxDecoration(color: const Color(0xFF00897B), borderRadius: BorderRadius.circular(10)),
                            child: const Text('🔰 পরিচালক', style: TextStyle(color: Colors.white, fontSize: 9, fontWeight: FontWeight.bold)),
                          ),
                      ],
                    ),
                    Text(post['time'], style: const TextStyle(color: Colors.grey, fontSize: 11)),
                  ],
                ),
                const Spacer(),
                IconButton(
                  icon: const Icon(Icons.chat_bubble_outline_rounded, color: Color(0xFF00897B), size: 20),
                  tooltip: 'পার্সোনাল মেসেজ',
                  onPressed: () {
                    Navigator.push(
                      context,
                      MaterialPageRoute(builder: (context) => ChatRoomScreen(chatTitle: post['author'])),
                    );
                  },
                )
              ],
            ),
            const SizedBox(height: 10),
            Text(post['content'], style: const TextStyle(fontSize: 14)),
            const SizedBox(height: 10),
            const Divider(),
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceAround,
              children: [
                TextButton.icon(
                  icon: Icon(post['isLiked'] ? Icons.thumb_up : Icons.thumb_up_outlined, size: 18, color: post['isLiked'] ? const Color(0xFF00897B) : Colors.grey),
                  label: Text('${post['likes']} লাইক', style: TextStyle(color: post['isLiked'] ? const Color(0xFF00897B) : Colors.grey)),
                  onPressed: () {
                    setState(() { AppState.toggleLike(index); });
                  },
                ),
                TextButton.icon(
                  icon: const Icon(Icons.mode_comment_outlined, size: 18, color: Colors.grey),
                  label: Text('${comments.length} কমেন্ট', style: const TextStyle(color: Colors.grey)),
                  onPressed: () => _showCommentDialog(index),
                ),
              ],
            ),
            if (comments.isNotEmpty) ...[
              const Divider(),
              Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: comments.map((c) => Padding(padding: const EdgeInsets.only(top: 2.0), child: Text('💬 $c', style: const TextStyle(fontSize: 12)))).toList(),
              ),
            ]
          ],
        ),
      ),
    );
  }
}

